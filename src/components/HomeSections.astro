---
const base = import.meta.env.BASE_URL;
---

<div class="home-content">
  <section class="home-section introduction" aria-labelledby="introduction-title">
    <p class="eyebrow section-label">What we do</p>
    <div class="introduction-layout">
      <h2 id="introduction-title">Big changes.<br />Finishing touches.<br />All home.</h2>
      <p class="section-copy">From kitchen and bathroom renovations to drywall and painting, SJIMNZ Construction helps homeowners improve the spaces they use every day.</p>
    </div>
  </section>

  <section class="home-section services-section" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="eyebrow section-label">01 / What we offer</p>
      <h2 id="services-title">Services</h2>
    </div>
    <div class="services-layout">
      <article class="service-feature">
        <img src={`${base}images/projects/kitchen.jpeg`} alt="Kitchen with gray cabinetry, a range hood and tile backsplash" width="768" height="1024" loading="lazy" decoding="async" />
        <h3>Kitchen &amp; Bathroom Renovations</h3>
        <p class="section-copy">Thoughtful renovations that make kitchens and bathrooms more functional, comfortable, and suited to your home.</p>
        <a class="text-link" href={`${base}services/`}>Explore renovations <span aria-hidden="true">↗</span></a>
      </article>
      <article class="service-feature">
        <img src={`${base}images/projects/drywall.jpeg`} alt="Interior walls and ceiling with drywall joints prepared for finishing" width="768" height="1024" loading="lazy" decoding="async" />
        <h3>Drywall, Spackle &amp; Painting</h3>
        <p class="section-copy">From surface preparation to finishing coats, we help bring a clean, refreshed look to your interior spaces.</p>
        <a class="text-link" href={`${base}services/`}>Explore finishing services <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="home-section work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow section-label">02 / Selected work</p>
      <h2 id="work-title">The work,<br />in the details.</h2>
    </div>
    <div class="work-gallery">
      <figure class="work-primary">
        <img src={`${base}images/projects/kitchen-detail.jpeg`} alt="Kitchen with a peninsula, wood seating and pendant lighting" width="768" height="1024" loading="lazy" decoding="async" />
        <figcaption>Kitchen renovation</figcaption>
      </figure>
      <figure class="work-bathroom">
        <img src={`${base}images/projects/bathroom.jpeg`} alt="Freestanding bathtub beside tiled walls beneath a skylight" width="768" height="1024" loading="lazy" decoding="async" />
        <figcaption>Bathroom finishes</figcaption>
      </figure>
      <figure>
        <img src={`${base}images/projects/staircase.jpg`} alt="Wood staircase with a matching handrail and horizontal metal balusters" width="380" height="410" loading="lazy" decoding="async" />
        <figcaption>Staircase details</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-section about-section" aria-labelledby="about-title">
    <p class="eyebrow section-label">03 / About SJIMNZ</p>
    <div class="about-layout">
      <div>
        <h2 id="about-title">Your home is personal.<br />So is our approach.</h2>
        <p class="section-copy">SJIMNZ Construction approaches residential improvements with attention to the details that make a house feel like home.</p>
        <a class="text-link" href={`${base}about/`}>About SJIMNZ <span aria-hidden="true">↗</span></a>
      </div>
      <div class="company-person">
        <p class="eyebrow">The person behind the work</p>
        <p class="person-name">Sergio J.<br />Jimenez</p>
        <p class="eyebrow">CEO / Manager</p>
      </div>
    </div>
  </section>

  <section class="home-section final-cta" aria-labelledby="contact-title">
    <p class="eyebrow section-label">04 / Let’s talk about your home</p>
    <h2 id="contact-title">Let's build on what<br />you call home.</h2>
    <p class="section-copy">Tell us what you're planning. SJIMNZ Construction can help you take the next step.</p>
    <div class="contact-actions">
      <a class="button" href={`${base}contact/`}>
        Get a free estimate
        <img src={`${base}images/arrow.svg`} alt="" width="19.2803" height="19.2803" />
      </a>
      <a class="contact-phone" href="tel:+12158003372">+1 (215) 800-3372</a>
    </div>
  </section>
</div>

---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-layout">
    <a class="brand" href={`${base}`} aria-label="SJimnz Construction home">
      <img src={`${base}images/construction-mark.svg`} alt="" width="36" height="38" loading="lazy" />
      <span class="wordmark">
        <span class="brand-name">SJimnz</span>
        <span class="brand-descriptor">CONSTRUCTION LLC</span>
      </span>
    </a>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={`${base}`} aria-current="page">Home</a>
      <a href={`${base}about/`}>About</a>
      <a href={`${base}services/`}>Services</a>
      <a href={`${base}contact/`}>Contact Us</a>
    </nav>
    <div class="footer-contact">
      <p class="eyebrow">Get in touch</p>
      <a href="tel:+12158003372">+1 (215) 800-3372</a>
      <a href="mailto:info@sjimnzconstruction.com">info@sjimnzconstruction.com</a>
    </div>
    <div class="footer-location">
      <p class="eyebrow">Find us</p>
      <address>499 W County Line Rd,<br />Hatboro, PA 19040, USA</address>
      <p class="footer-license">License Number PA147397</p>
    </div>
  </div>
  <p class="footer-copyright">© {year} SJIMNZ Construction LLC. All rights reserved.</p>
</footer>
